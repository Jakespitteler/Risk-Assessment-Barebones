{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.envrc)",
      "Read(//**/.netrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/secrets/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.data/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/.envrc)",
      "Edit(//**/.netrc)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/.aws/**)",
      "Edit(//**/.data/**)"
    ],
    "allow": [
      "Bash(uv run check.py)",
      "Bash(uv run check.py --fix)",
      "Bash(uv run test.py)",
      "Bash(uv run test.py *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:e2e)",
      "Bash(npm run generate:api)",
      "Bash(npx markdownlint-cli2@0.24.0 *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(uv run check.py)",
      "PowerShell(uv run check.py --fix)",
      "PowerShell(uv run test.py)",
      "PowerShell(uv run test.py *)",
      "PowerShell(uv run pytest)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff *)",
      "PowerShell(uv run pyright *)",
      "PowerShell(npm test)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run test:e2e)",
      "PowerShell(npm run generate:api)",
      "PowerShell(npx markdownlint-cli2@0.24.0 *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Grep|Glob|NotebookEdit|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks/guard_tool_use.py"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks/format_edited_file.py"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
